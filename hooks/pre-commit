#!/bin/sh

# Pre-commit hook to check app bundle size
# This hook builds the Tauri app and checks if the bundle size exceeds the limit

echo "🔨 Building Tauri app to check bundle size..."

# Build the frontend
bun run build
if [ $? -ne 0 ]; then
  echo "❌ Frontend build failed"
  exit 1
fi

# Build the Tauri app
bun run tauri build
if [ $? -ne 0 ]; then
  echo "❌ Tauri build failed"
  exit 1
fi

echo ""
echo "📏 Checking bundle size..."

# Check the bundle size with 10 MB limit
node scripts/measure-bundle-size.js --max-size=10
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Commit blocked: App bundle size exceeds 10 MB limit"
  echo "💡 Tip: Reduce dependencies or optimize assets to decrease bundle size"
  exit 1
fi

echo "✅ Bundle size check passed"
exit 0
